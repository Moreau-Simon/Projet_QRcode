# ==============================================================================
# Variables d'Environnement - Exemple (.env.example)
# Copier ce fichier en '.env' et adapter les valeurs sensibles en production.
# ==============================================================================

# Base de données PostgreSQL (Administrateur / Superuser du conteneur)
POSTGRES_DB=ma_base_de_donnees
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_super_secret

# Utilisateur Applicatif Dédié (Non-root) pour le service Data Access C#
APP_DB_USER=data_user
APP_DB_PASSWORD=change_me_app_password

# Hôtes et Ports des services internes
PSQL_HOST=psql
PSQL_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# URLs des Micro-services internes (pour l'Ambassadeur)
JOB_URL=http://job-python:5000/scan
DATA_URL=http://data-csharp:5000/api/save
